        {"key": "image", "type": "image", "label": "Billede", "required": true, "showWhen": {"field": "kind", "equals": "image"}},
        {"key": "backgroundImage", "type": "image", "label": "Baggrundsbillede", "showWhen": {"field": "kind", "equals": "custom"}},
        {"key": "headline", "type": "text", "label": "Rubrik", "showWhen": {"field": "kind", "equals": "custom"}},
        {"key": "headlineColor", "type": "color", "label": "Farve på rubrik", "palette": "brand", "showWhen": {"field": "kind", "equals": "custom"}},
        {"key": "title", "type": "text", "label": "Titel", "showWhen": {"field": "kind", "equals": "custom"}},
        {"key": "titleColor", "type": "color", "label": "Farve på titel", "palette": "brand", "showWhen": {"field": "kind", "equals": "custom"}},
        {"key": "footerLabel", "type": "text", "label": "Tekst i bunden", "showWhen": {"field": "kind", "equals": "custom"}},
        {"key": "footerLabelColor", "type": "color", "label": "Farve på tekst i bunden", "palette": "brand", "showWhen": {"field": "kind", "equals": "custom"}},
        {"key": "link", "type": "link", "label": "Link", "showWhen": {"field": "kind", "in": ["custom", "image"]}},
        {"key": "directusId", "type": "text", "label": "Kort-id i Directus", "required": true, "showWhen": {"field": "kind", "equals": "global"}}
      ] }
  ]
